<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.dashboard.DashboardFragment"
    android:background="@color/black">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:fontFamily="@font/robotobold"
        android:text="Sell Product"
        android:textColor="@color/white"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <EditText
        android:id="@+id/sell_name"
        android:layout_margin="10dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/edittext_back"
        android:fontFamily="@font/robotoregular"
        android:hint="Product Name"
        android:padding="10dp"
        android:textColor="@color/darkgrey"
        android:textColorHint="@color/darkgrey"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <EditText
        android:id="@+id/sell_desc"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_margin="10dp"
        android:background="@drawable/edittext_back"
        android:fontFamily="@font/robotoregular"
        android:hint="Product Description"
        android:padding="10dp"
        android:textColor="@color/darkgrey"
        android:textColorHint="@color/darkgrey"
        app:layout_constraintTop_toBottomOf="@+id/sell_name" />

    <EditText
        android:id="@+id/sell_cost"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="10dp"
        android:background="@drawable/edittext_back"
        android:fontFamily="@font/robotoregular"
        android:hint="Cost (In ₹)"
        android:padding="10dp"
        android:textColor="@color/darkgrey"
        android:textColorHint="@color/darkgrey"
        app:layout_constraintTop_toBottomOf="@+id/itemTypeSpinner" />

    <Spinner
        android:background="@drawable/edittext_back"
        android:layout_margin="10dp"
        android:id="@+id/itemTypeSpinner"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:padding="8dp"
        android:spinnerMode="dropdown"
        app:layout_constraintTop_toBottomOf="@+id/sell_desc" />

    <TextView
        android:layout_margin="10dp"
        android:background="@drawable/button_back"
        android:text="Next Step"
        android:textColor="@color/white"
        android:fontFamily="@font/robotobold"
        android:gravity="center"
        android:textSize="20sp"
        android:clickable="true"
        android:focusable="true"
        android:id="@+id/btnNextStep"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@+id/sell_cost" />

</androidx.constraintlayout.widget.ConstraintLayout>